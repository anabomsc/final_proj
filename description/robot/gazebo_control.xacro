<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="frame_prefix" default="artbot_" />
    <xacro:arg name="topic_prefix" default="artbot/" />
    
    <gazebo>
        <plugin filename="ignition-gazebo-diff-drive-system"
        name="ignition::gazebo::systems::DiffDrive">

            <!-- Wheel Information -->
            <left_joint>$(arg frame_prefix)left_wheel_joint</left_joint>
            <right_joint>$(arg frame_prefix)right_wheel_joint</right_joint>
            <wheel_separation>0.297</wheel_separation>
            <wheel_radius>0.033</wheel_radius>

            <!-- Limits -->
            <max_linear_acceleration>1</max_linear_acceleration>
            <min_linear_acceleration>-1</min_linear_acceleration>
            <max_angular_acceleration>2</max_angular_acceleration>
            <min_angular_acceleration>-2</min_angular_acceleration>
            <max_linear_velocity>0.5</max_linear_velocity>
            <min_linear_velocity>-0.5</min_linear_velocity>
            <max_angular_velocity>1</max_angular_velocity>
            <min_angular_velocity>-1</min_angular_velocity>

            <!-- Input -->
            <topic>/$(arg topic_prefix)cmd_vel</topic>

            <!-- Output -->
            <frame_id>$(arg frame_prefix)odom</frame_id>
            <child_frame_id>$(arg frame_prefix)base_link</child_frame_id>
            <odom_topic>/$(arg topic_prefix)gt_odom</odom_topic>
            <odom_publisher_frequency>20</odom_publisher_frequency>
            <tf_topic>/gt_pose</tf_topic>

        </plugin>

        <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
            <topic>/$(arg topic_prefix)joint_states</topic>
            <joint_name>$(arg frame_prefix)left_wheel_joint</joint_name>
            <joint_name>$(arg frame_prefix)right_wheel_joint</joint_name>
        </plugin>

        <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
            <odom_frame>$(arg frame_prefix)odom</odom_frame>
            <robot_base_frame>$(arg frame_prefix)base_link</robot_base_frame>

            <odom_topic>/$(arg topic_prefix)odom_raw</odom_topic>
            <odom_covariance_topic>/$(arg topic_prefix)odom_with_covariance_raw</odom_covariance_topic>
            <tf_topic>/$(arg topic_prefix)pose_raw</tf_topic>

            <dimensions>2</dimensions>
            <odom_publish_frequency>20</odom_publish_frequency>
            <gaussian_noise>0.0</gaussian_noise>
        </plugin>

    </gazebo>
</robot>